# 复制为 .env.local 后填写真实值；不要修改并提交本模板中的占位符。
OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
ZAI_API_KEY=your_zai_api_key

# 可选的统一覆盖项
TRICODER_MODEL=
TRICODER_BASE_URL=
TRICODER_MAX_ROUNDS=12
TRICODER_MAX_CONTEXT_CHARS=80000
TRICODER_TIMEOUT=30

# 工具协议只接受 native 或 legacy_json；默认使用原生 structured tool calling。
# 仅在兼容性排查时显式改为 legacy_json，并用 doctor 确认当前值。
TRICODER_TOOL_PROTOCOL=native
